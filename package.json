{
  "name": "dsh-session-rules",
  "version": "0.4.0",
  "description": "Per-session rules and notes for DeepSeek Harness: edit this conversation's constraints and coding conventions in a popup, import existing project guidelines read-only, and save rules extracted from the conversation. The saved text is injected into that session's system prompt on the next model call.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "prompt"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run build && node test/selfcheck.mjs",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "meta": {
    "title": "Session Rules",
    "description": "会话守则：为本会话设置注意事项与规范，支持导入项目现有规范（只读）和从对话中提炼保存。"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lw0129a/dsh-session-rules.git"
  },
  "homepage": "https://github.com/lw0129a/dsh-session-rules#readme",
  "bugs": {
    "url": "https://github.com/lw0129a/dsh-session-rules/issues"
  }
}
